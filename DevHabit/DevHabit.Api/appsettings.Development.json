{
  "ConnectionStrings": {
    "Database": "Host=devhabit.postgres;Database=devhabit;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtAuthSettings": {
    "Key": "your-secret-key-hare-that-should-also-be-fairly-long",
    "Issuer": "DevHabitApi",
    "Audience": "DevHabitClient",
    "ExpirationInMinutes": 30,
    "RefreshTokenExpirationInDays": 7
  },
  "EncryptionSettings": {
    "Key": "your-secret-key-hare-that-should-also-be-exactly-32-bytes-long"
  },
  "GitHubAutomation": {
    "ScanIntervalMinutes": 15
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
